# ===========================================
# 미래 EKS 재구축시 사용할 보안그룹 설정
# 현재는 .backup 확장자로 비활성화
# EKS 클러스터 재구축시 .backup 제거하여 활성화
# ===========================================

# EKS 클러스터용 보안그룹 (재구축시 사용)
resource "aws_security_group" "eks_cluster_sg_future" {
  name        = "${var.cluster_name}-cluster-sg-v2"
  description = "Secure security group for EKS cluster"
  vpc_id      = data.aws_vpc.kubox_vpc.id

  # HTTPS API 서버 접근 (VPC 내부만)
  ingress {
    description = "HTTPS API server access from VPC"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  # 모든 아웃바운드 허용
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.cluster_name}-cluster-sg-v2"
    Description = "EKS cluster security group - restricted access (no ICMP, no 0.0.0.0/0)"
  }
}

# EKS 워커 노드용 보안그룹 (재구축시 사용)
resource "aws_security_group" "eks_node_sg_future" {
  name        = "${var.cluster_name}-node-sg-v2"
  description = "Secure security group for EKS worker nodes"
  vpc_id      = data.aws_vpc.kubox_vpc.id

  # 클러스터와 노드 간 통신
  ingress {
    description     = "Cluster to node communication"
    from_port       = 0
    to_port         = 0
    protocol        = "-1"
    security_groups = [aws_security_group.eks_cluster_sg_future.id]
  }

  # 노드 간 통신 (자기 자신)
  ingress {
    description = "Node to node communication"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    self        = true
  }

  # SSH 접근 (VPC 내부만)
  ingress {
    description = "SSH access from VPC only"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  # NodePort 서비스용 (VPC 내부만)
  ingress {
    description = "NodePort services from VPC only"
    from_port   = 30000
    to_port     = 32767
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"]
  }

  # 모든 아웃바운드 허용
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.cluster_name}-node-sg-v2"
    Description = "EKS worker node security group - restricted access (no ICMP, no public NodePorts)"
  }
}

# ===========================================
# 재구축시 main.tf에서 사용할 설정 예시:
# ===========================================
# 
# EKS 클러스터 설정:
# vpc_config {
#   subnet_ids              = data.aws_subnets.private_subnets.ids
#   security_group_ids      = [aws_security_group.eks_cluster_sg_future.id]
#   endpoint_private_access = true
#   endpoint_public_access  = true
# }
#
# EKS 노드 그룹 설정:
# remote_access {
#   ec2_ssh_key               = "kubox_s"
#   source_security_group_ids = [aws_security_group.eks_node_sg_future.id]
# }
#